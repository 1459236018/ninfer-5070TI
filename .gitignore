# ── 模型权重（每个 10 GiB 以上，绝不入库）────────────────────────
*.ninfer

# ── 引擎二进制（710 MB exe + 1 个 DLL 系 600 MB）────────────────
# 引擎通过 GitHub Releases 分发，见 README「下载引擎」。
engine/*.exe
engine/*.dll

# ── 打包产物与历史包 ────────────────────────────────────────────
dist/
*.zip

# ── 运行时产物：日志、会话、缓存 ───────────────────────────────
logs/
*.log
*.jsonl
*.err
*.resp

# ── 本地实验与临时数据 ─────────────────────────────────────────
.workbuddy/
.workbuddy-ai/
.backup-*/
_scratch/
*.bak
*.bak-*

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 编辑器 / 系统 ─────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini

# ── 规划与实验报告（含本机路径，只保留 reports/README.md 说明）────
reports/*
!reports/README.md
